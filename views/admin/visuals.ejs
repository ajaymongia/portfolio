<%- include('_shell') %>
<div class="page-head">
  <div><h1>Visual designs</h1><p>The image gallery carousel. Around 1600 × 1000 (3:2) keeps every slide the same shape.</p></div>
</div>

<div class="add-panel">
  <button class="btn btn-ghost add-toggle" type="button" data-add-toggle="add-visual" aria-expanded="false">+ Add image</button>
  <div class="card" id="add-visual" hidden>
    <form method="post" action="/admin/visuals/new" enctype="multipart/form-data">
      <div class="media-row">
        <img class="media-preview wide" src="/img/favicon.svg" alt="">
        <div class="field" style="flex:1;min-width:220px">
          <label for="v_image">Image</label>
          <input id="v_image" name="image" type="file" accept="image/*" required>
        </div>
      </div>
      <div class="row" style="margin-top:1.1rem">
        <div class="field"><label for="v_title">Title</label><input id="v_title" name="title" type="text" required></div>
        <div class="field"><label for="v_tag">Small label</label><input id="v_tag" name="tag" type="text" placeholder="Mobile UI · Client work"></div>
      </div>
      <div class="field"><label for="v_caption">Caption</label><textarea id="v_caption" name="caption" class="short"></textarea></div>
      <div class="actions"><button class="btn btn-primary" type="submit">Add image</button></div>
    </form>
  </div>
</div>

<% visuals.forEach(function (v, i) { %>
  <div class="item">
    <div class="item-head">
      <% if (v.src) { %><img src="<%= v.src %>" alt=""><% } else { %><span class="thumbless">—</span><% } %>
      <div>
        <div class="item-title"><%= v.title %></div>
        <div class="item-sub"><%= v.tag %></div>
      </div>
      <div class="item-tools">
        <form method="post" action="/admin/visuals/<%= v.id %>/move"><input type="hidden" name="dir" value="up"><button class="btn btn-ghost btn-sm" type="submit" <%= i === 0 ? 'disabled' : '' %>>↑</button></form>
        <form method="post" action="/admin/visuals/<%= v.id %>/move"><input type="hidden" name="dir" value="down"><button class="btn btn-ghost btn-sm" type="submit" <%= i === visuals.length - 1 ? 'disabled' : '' %>>↓</button></form>
        <button class="disclose" type="button" data-disclose aria-expanded="false">Edit</button>
      </div>
    </div>
    <div class="item-body">
      <form method="post" action="/admin/visuals/<%= v.id %>" enctype="multipart/form-data">
        <div class="media-row">
          <img class="media-preview wide" src="<%= v.src || '/img/favicon.svg' %>" alt="">
          <div class="field" style="flex:1;min-width:220px">
            <label>Replace image</label>
            <input name="image" type="file" accept="image/*">
          </div>
        </div>
        <div class="row" style="margin-top:1.1rem">
          <div class="field"><label>Title</label><input name="title" type="text" value="<%= v.title %>"></div>
          <div class="field"><label>Small label</label><input name="tag" type="text" value="<%= v.tag %>"></div>
        </div>
        <div class="field"><label>Caption</label><textarea name="caption" class="short"><%= v.caption %></textarea></div>
        <div class="actions"><button class="btn btn-primary" type="submit">Save</button><span class="spacer"></span></div>
      </form>
      <form method="post" action="/admin/visuals/<%= v.id %>/delete" data-confirm="Delete “<%= v.title %>”?" style="margin-top:0.75rem">
        <button class="btn btn-danger btn-sm" type="submit">Delete</button>
      </form>
    </div>
  </div>
<% }); %>
<%- include('_foot') %>
