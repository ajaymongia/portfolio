<div class="carousel logo-carousel" data-carousel data-autoscroll="30">
  <div class="carousel-viewport" tabindex="0" role="group" aria-label="Other clients, scrollable">
    <ul class="carousel-track">
      <% clients.forEach(function (c) { %>
        <li class="carousel-item logo-slide">
          <div class="logo-tile"<%= c.logo ? '' : ' data-placeholder' %>>
            <% if (c.logo) { %>
              <img src="<%= c.logo %>" alt="<%= c.name %>" loading="lazy" decoding="async">
            <% } else { %>
              <span class="logo-placeholder-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="4" width="18" height="16" rx="2.5"/>
                  <circle cx="8.5" cy="9.5" r="1.6"/>
                  <path d="M3.5 17 L9 12 L13 15.5 L16.5 12.5 L20.5 16" stroke-linecap="round" stroke-linejoin="round"/>
                </g></svg>
              </span>
              <span class="logo-name"><%= c.name %></span>
            <% } %>
          </div>
        </li>
      <% }); %>
    </ul>
  </div>
  <%- include('carousel-controls') %>
</div>
