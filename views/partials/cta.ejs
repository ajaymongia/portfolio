<section class="cta">
  <div class="wrap">
    <div class="cta-inner">
      <h2 class="display-md" data-split>Got something<br>worth designing properly?</h2>
      <p class="cta-text" data-reveal>Tell me what you are building and where it is stuck. If it is a fit, I will come back with an approach and a timeline.</p>
      <div class="btn-row" data-reveal>
        <a class="btn btn-accent btn-lg" href="<%= onePage ? '#contact' : '/#contact' %>">Start a conversation</a>
        <a class="btn btn-ghost btn-lg" href="mailto:<%= site.email %>"><%= site.email %></a>
      </div>
    </div>
  </div>
</section>
